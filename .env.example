# Recommended: npm run setup (interactive English / Urdu, no default credentials).
# Existing MySQL 8 database only. URL-encode username/password; never commit .env.local.
# Example shape: mysql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/mehria_pulao
DATABASE_URL=

# Canonical browser origin, mandatory for production admin authentication.
# Production requires HTTPS except local testing on localhost/127.0.0.1/::1.
APP_URL=http://localhost:3000

# Verify both certificate chain and hostname for remote MySQL connections.
# NODE_EXTRA_CA_CERTS can add a private CA. Never disable certificate verification.
DB_SSL=false

# Each secret must have at least 32 characters. setup generates random values if absent.
# Share each value across all app instances. Keep secrets private.
RATE_LIMIT_SECRET=
ADMIN_AUTH_SECRET=

# INITIAL MIGRATION SEED ONLY. Later changes happen in /admin/settings, without restart.
# Safe defaults: ordering paused and delivery disabled. Setup NEVER approves menu rows.
ORDERING_ENABLED=false
DELIVERY_AREAS=
# Integer paisa: 10000 = PKR 100. No card or online payments are supported.
DELIVERY_FEE_PAISA=0
